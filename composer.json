{
    "name": "lamentor/lamentor",
    "description": "Lamentor: an open-source visual page builder for Laravel, compatible with the Elementor JSON document format.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "Lamentor\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Lamentor\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Lamentor\\LamentorServiceProvider"]
        }
    },
    "minimum-stability": "stable"
}
